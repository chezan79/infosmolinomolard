modules = ["nodejs-20", "web", "python-base-3.13"]
run = "npm start"

[nix]
channel = "stable-24_05"
packages = ["jdk17_headless"]

[deployment]
run = ["npm", "start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Web Server"
author = 43042775
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node .local/previews/winners-photo-verification.cjs"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8374
externalPort = 3001

[[ports]]
localPort = 9005
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 3002

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.development]
ELECTION_DATA_ENVIRONMENT = "development"
ELECTION_TIME_ZONE = "Europe/Zurich"
ELECTION_TRUST_PROXY_HOPS = "1"
EMPLOYEE_DIRECTORY_SHEET_RANGE = "Collaborateurs!A:M"
EMPLOYEE_DIRECTORY_SITE_ID = "molard"
