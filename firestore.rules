rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The employee directory snapshot contains server-only verifier material.
    // It is available exclusively through the Firebase Admin SDK in Express.
    match /employeeDirectorySnapshots/{siteId} {
      allow read, write: if false;
    }

    // Preserve the browser collections already used by the existing app.
    // Their permissive legacy policy should be replaced in a separate,
    // authenticated migration rather than silently broken by this feature.
    match /planning/{document=**} {
      allow read, write: if true;
    }
    match /enrollments/{document=**} {
      allow read, write: if true;
    }
    match /trainings/{document=**} {
      allow read, write: if true;
    }
  }
}