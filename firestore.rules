rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The employee directory snapshot contains server-only verifier material.
    // It is available exclusively through the Firebase Admin SDK in Express.
    match /employeeDirectorySnapshots/{siteId} {
      allow read, write: if false;
    }
    match /employeePhotoSites/{document=**} {
      allow read, write: if false;
    }

    // All election records and nested grants, throttles, participation,
    // anonymous ballots, audits and result internals are Express-only.
    match /electionSites/{document=**} {
      allow read, write: if false;
    }

    // These collections contain operational and personnel data. The current
    // application accesses them through the server-side Admin SDK only.
    match /planning/{document=**} {
      allow read, write: if false;
    }
    match /enrollments/{document=**} {
      allow read, write: if false;
    }
    match /trainings/{document=**} {
      allow read, write: if false;
    }
  }
}