{
  "name": "molino-molard-planning",
  "version": "1.0.0",
  "description": "App per gestire i planning del ristorante",
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node --check server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "test:firestore-rules": "firebase emulators:exec --only firestore,storage \"node --test test/firestore-rules.emulator.js\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "form-data": "2.5.6",
    "google-gax": {
      "@grpc/grpc-js": "1.14.5"
    },
    "protobufjs": "7.6.5",
    "websocket-driver": "0.7.5"
  }
}
