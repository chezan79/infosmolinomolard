#!/usr/bin/env python3
"""Provide GitHub HTTPS credentials from the Replit GIT_URL secret at runtime."""

import os
import sys
from urllib.parse import unquote, urlsplit


def read_request():
    fields = {}
    for line in sys.stdin:
        if line in ("\n", "\r\n"):
            break
        key, separator, value = line.rstrip("\r\n").partition("=")
        if separator:
            fields[key] = value
    return fields


def credentials_from_secret(secret):
    if not secret or "\n" in secret or "\r" in secret:
        return None

    if "://" not in secret:
        return ("x-access-token", secret)

    try:
        parsed = urlsplit(secret)
        if parsed.scheme.lower() != "https" or (parsed.hostname or "").lower() != "github.com":
            return None
        username = unquote(parsed.username or "")
        password = unquote(parsed.password or "")
    except ValueError:
        return None

    # Accept standard username:token URLs and token-only userinfo URLs.
    if password:
        return (username or "x-access-token", password)
    if username:
        return ("x-access-token", username)
    return None


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return 0

    request = read_request()
    if request.get("protocol", "").lower() != "https":
        return 0
    if request.get("host", "").lower() != "github.com":
        return 0

    credentials = credentials_from_secret(os.environ.get("GIT_URL", ""))
    if not credentials:
        return 0
    username, password = credentials
    if any(character in value for value in (username, password) for character in "\r\n"):
        return 0

    sys.stdout.write(f"username={username}\npassword={password}\n\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())